# Dev-only: your machine's current LAN IP, to allow testing the dev server
# from another device on the network (e.g. a phone) at http://<ip>:3000.
# Leave unset if you don't need this. Not used in production.
# DEV_LAN_ORIGIN=192.168.1.59

# Google Sheets (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-sheet-id-here

# Mail - Option 1: Resend
RESEND_API_KEY=re_xxx

# Mail - Option 2: SMTP (used if RESEND_API_KEY is not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=karaduttas@gmail.com
SMTP_PASS=your-app-password

# Mail From
MAIL_FROM="Assos Karadut Taş Otel <noreply@karaduttasotel.com>"

# Admin Auth
ADMIN_EMAIL=admin@karaduttasotel.com
ADMIN_PASSWORD_HASH=$2a$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SESSION_SECRET=your-very-long-random-secret-at-least-32-characters

# Rate limiting (Upstash Redis) - optional in local dev; limiters no-op
# with a console warning when these are not set.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Cloudflare Turnstile (bot/abuse protection on the reservation form) -
# optional in local dev; verification is bypassed with a console warning
# when TURNSTILE_SECRET_KEY is not set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
